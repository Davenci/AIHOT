      "kind": "web_list",
      "tier": "T1",
      "owner_entity_id": "waymo",
      "config": {
        "_aihot": {
          "initialBackfillLimit": 4,
          "initialBackfillMonths": 12
        },
        "url": "https://waymo.com/research/",
        "parseMode": "html",
        "itemSelector": "li[data-slot=\"filterable\"]:has(h3 a[href^=\"/research/\"]):lt(8)",
        "linkSelector": "a[href^=\"https://arxiv.org/abs/\"]",
        "titleSelector": "h3 a[href^=\"/research/\"]",
        "allowUrlPrefixes": [
          "https://arxiv.org/abs/"
        ],
        "detail": {
          "maxFetches": 4,
          "publishedAtSelector": "meta[name=\"citation_date\"]",
          "publishedAtUtcOffset": "+00:00",
          "summarySelector": "blockquote.abstract"
        }
      },
