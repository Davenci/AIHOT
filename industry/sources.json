        "summaryPaths": [
          "paper.summary"
        ],
        "authorPaths": [
          "paper.authors.0.name"
        ],
        "urlTemplate": "https://arxiv.org/abs/{paper.id}",
        "externalIdPath": "paper.id",
        "publishedAtPath": "paper.publishedAt",
        "summaryIsBody": true,
        "sortByPublishedAt": true,
        "ingestNoiseFilter": {
          "dropMarkers": [
            ""
          ],
